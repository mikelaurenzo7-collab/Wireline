diff --git a/src/hooks/useRovingTabIndex.ts b/src/hooks/useRovingTabIndex.ts
new file mode 100644
index 00000000..4041f8b5
--- /dev/null
+++ b/src/hooks/useRovingTabIndex.ts
@@ -0,0 +1,66 @@
+import { useCallback, useRef, type KeyboardEvent } from "react";
+
+export type UseRovingTabIndexOptions<TId extends string> = {
+  itemIds: readonly TId[];
+  activeId: TId | null;
+  onActivate: (id: TId) => void;
+  itemSelector?: (id: TId) => string;
+};
+
+/**
+ * Roving tabindex for horizontal tablists: active item is tabbable (0), others -1.
+ * ArrowLeft/Right, Home, and End move selection and focus within the list.
+ */
+export function useRovingTabIndex<TId extends string>({
+  itemIds,
+  activeId,
+  onActivate,
+  itemSelector = (id) => `[data-roving-tab="${id}"]`,
+}: UseRovingTabIndexOptions<TId>) {
+  const listRef = useRef<HTMLDivElement>(null);
+
+  const getTabIndex = useCallback((id: TId) => (activeId === id ? 0 : -1), [activeId]);
+
+  const focusItem = useCallback(
+    (id: TId) => {
+      listRef.current?.querySelector<HTMLElement>(itemSelector(id))?.focus();
+    },
+    [itemSelector],
+  );
+
+  const handleKeyDown = useCallback(
+    (event: KeyboardEvent<HTMLDivElement>) => {
+      if (!itemIds.length) return;
+
+      const currentIndex = activeId ? itemIds.indexOf(activeId) : 0;
+      const resolvedIndex = currentIndex >= 0 ? currentIndex : 0;
+
+      let nextIndex: number | null = null;
+      switch (event.key) {
+        case "ArrowRight":
+          nextIndex = (resolvedIndex + 1) % itemIds.length;
+          break;
+        case "ArrowLeft":
+          nextIndex = (resolvedIndex - 1 + itemIds.length) % itemIds.length;
+          break;
+        case "Home":
+          nextIndex = 0;
+          break;
+        case "End":
+          nextIndex = itemIds.length - 1;
+          break;
+        default:
+          return;
+      }
+
+      event.preventDefault();
+      const nextId = itemIds[nextIndex];
+      if (!nextId) return;
+      onActivate(nextId);
+      focusItem(nextId);
+    },
+    [itemIds, activeId, onActivate, focusItem],
+  );
+
+  return { listRef, getTabIndex, handleKeyDown, focusItem };
+}
diff --git a/src/hooks/useStudioActiveAgentId.ts b/src/hooks/useStudioActiveAgentId.ts
new file mode 100644
index 00000000..17b65143
--- /dev/null
+++ b/src/hooks/useStudioActiveAgentId.ts
@@ -0,0 +1,19 @@
+import { useMemo } from "react";
+import { useSearchParams } from "react-router-dom";
+
+import { useAgents } from "../contexts/AgentsContext";
+import { resolveStudioActiveAgentId } from "../lib/studio-agent-preference";
+
+/** Shared MRU-aware active agent resolution for shell chrome and canvas. */
+export function useStudioActiveAgentId() {
+  const [params] = useSearchParams();
+  const { agents } = useAgents();
+  const requestedId = params.get("agent");
+  const agentIds = useMemo(() => agents.map((agent) => agent.id), [agents]);
+  const resolvedId = useMemo(
+    () => resolveStudioActiveAgentId(requestedId, agentIds),
+    [requestedId, agentIds],
+  );
+
+  return { requestedId, resolvedId, agents };
+}
diff --git a/src/lib/studio-agent-preference.ts b/src/lib/studio-agent-preference.ts
new file mode 100644
index 00000000..0bbff1c6
--- /dev/null
+++ b/src/lib/studio-agent-preference.ts
@@ -0,0 +1,40 @@
+export const KEY = "wireline:studio:last-agent-id";
+
+function studioStorage(): Storage | null {
+  if (typeof window !== "undefined") return window.localStorage;
+  return (globalThis as { localStorage?: Storage }).localStorage ?? null;
+}
+
+export function readStudioLastAgentId(): string | null {
+  return studioStorage()?.getItem(KEY) ?? null;
+}
+
+export function writeStudioLastAgentId(id: string): void {
+  studioStorage()?.setItem(KEY, id);
+}
+
+export function clearStudioLastAgentId(): void {
+  studioStorage()?.removeItem(KEY);
+}
+
+/**
+ * Resolves the active Studio agent id from URL request, MRU, or roster order.
+ * - requestedId when present in agentIds
+ * - else MRU when still in roster
+ * - else first agent id, or null when roster is empty
+ */
+export function resolveStudioActiveAgentId(
+  requestedId: string | null,
+  agentIds: string[],
+): string | null {
+  if (requestedId && agentIds.includes(requestedId)) {
+    return requestedId;
+  }
+
+  const mru = readStudioLastAgentId();
+  if (mru && agentIds.includes(mru)) {
+    return mru;
+  }
+
+  return agentIds[0] ?? null;
+}
