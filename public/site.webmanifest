{
  "name": "BotBound | Voice Bots",
  "short_name": "BotBound",
  "description": "Voice Bots for business calls. Calls plans include a local number; Email plans add a branded BotBound inbox.",
  "id": "/",
  "start_url": "/studio",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#0A0A0E",
  "background_color": "#0A0A0E",
  "lang": "en-US",
  "categories": ["productivity", "utilities", "communications"],
  "icons": [
    { "src": "/botbound-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/botbound-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/botbound-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Bot Studio", "short_name": "Studio", "description": "Build and configure a Bot in BotBound.", "url": "/studio" },
    { "name": "Inbox", "short_name": "Inbox", "description": "Review texts and email by Bot.", "url": "/inbox" },
    { "name": "Calls", "short_name": "Calls", "description": "Manage lines and review call history.", "url": "/phone" }
  ],
  "prefer_related_applications": false
}
