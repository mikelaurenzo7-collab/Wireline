      "purpose": "any"
    },
    {
      "src": "/wireline-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "BOT STUDIO",
