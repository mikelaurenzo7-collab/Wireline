  "start_url": "/studio",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "theme_color": "#0A0A0E",
  "background_color": "#0A0A0E",
  "lang": "en-US",
