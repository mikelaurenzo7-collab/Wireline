    "productivity",
    "utilities",
    "communications"
  ],
  "icons": [
    {
      "src": "/wireline-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/wireline-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Studio",
      "short_name": "Studio",
      "description": "Open the chat-first workroom",
      "url": "/studio"
    },
    {
      "name": "Agents",
      "short_name": "Agents",
      "description": "See your agents",
      "url": "/agents"
    },
    {
      "name": "Training",
