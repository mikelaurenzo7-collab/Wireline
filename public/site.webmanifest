{
  "name": "Wireline",
  "short_name": "Wireline",
  "description": "AI voice and email agents for your business.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#1A3C34",
  "background_color": "#F7F7F5",
  "lang": "en-US",
  "categories": ["business", "productivity", "communications"],
  "icons": [
    { "src": "/wireline-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Triage", "short_name": "Triage", "description": "Open hot leads and compliance inbox", "url": "/triage" },
    { "name": "Call Logs", "short_name": "Calls", "description": "View recorded calls and agent responses", "url": "/logs" },
    { "name": "Agents", "short_name": "Agents", "description": "Manage your AI agents", "url": "/agents" }
  ],
  "prefer_related_applications": false
}
