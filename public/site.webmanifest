{
  "name": "Wireline — AI Call Assistant",
  "short_name": "Wireline",
  "description": "Wireline makes the calls, waits on hold, captures the answer, and handles follow-ups so you get time back.",
  "id": "/",
  "start_url": "/studio",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#1A3C34",
  "background_color": "#F9F9F7",
  "lang": "en-US",
  "categories": ["productivity", "utilities", "communications"],
  "icons": [
    { "src": "/wireline-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Studio", "short_name": "Studio", "description": "Ask Wireline to handle a call or follow-up", "url": "/studio" },
    { "name": "Assistants", "short_name": "Assistants", "description": "See the assistants you have set up", "url": "/agents" },
    { "name": "Knowledge", "short_name": "Knowledge", "description": "Add facts, preferences, and boundaries", "url": "/knowledge" }
  ],
  "prefer_related_applications": false
}
