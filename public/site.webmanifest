{
  "name": "Wireline",
  "short_name": "Wireline",
  "description": "AI voice and email agents for your business — powered by Claude.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#8B3FD6",
  "background_color": "#EFE9DC",
  "lang": "en-US",
  "categories": ["business", "productivity", "communications"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/wireline-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/wireline-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/wireline-icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/wireline-icon-rounded.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Triage",
      "short_name": "Triage",
      "description": "Open hot leads and compliance inbox",
      "url": "/triage",
      "icons": [{ "src": "/wireline-icon-512.png", "sizes": "512x512" }]
    },
    {
      "name": "Call Logs",
      "short_name": "Calls",
      "description": "View recorded calls and agent responses",
      "url": "/logs",
      "icons": [{ "src": "/wireline-icon-512.png", "sizes": "512x512" }]
    },
    {
      "name": "Agents",
      "short_name": "Agents",
      "description": "Manage your AI agents",
      "url": "/agents",
      "icons": [{ "src": "/wireline-icon-512.png", "sizes": "512x512" }]
    }
  ],
  "prefer_related_applications": false
}
