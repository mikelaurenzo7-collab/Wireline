    { "src": "/wireline-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/wireline-icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "/wireline-icon-rounded.png", "sizes": "1024x1024", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
