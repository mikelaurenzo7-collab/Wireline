{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "botbound": {
      "type": "streamable-http",
      "url": "https://botbound.app/mcp"
    },
    "browserbase": {
      "type": "streamable-http",
      "url": "https://mcp.browserbase.com/mcp",
      "headers": {
        "Authorization": "Bearer ${BROWSERBASE_API_KEY}"
      }
    }
  }
}
