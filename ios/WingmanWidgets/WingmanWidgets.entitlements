<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match Wingman.entitlements and WingmanWidgetShared.appGroupId so
	     the widget can read the snapshot the app writes. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.wireline.wingman</string>
	</array>
</dict>
</plist>
