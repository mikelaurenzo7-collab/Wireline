<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core bundle identity. Keep these explicit: App Intents reads the
	     processed bundle plist during SSU training. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleDisplayName</key>
	<string>Wireline</string>
	<key>CFBundleName</key>
	<string>Wireline</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Enables the active-call Live Activity / Dynamic Island surface. -->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- Wake on inbound-call VoIP push, finish call audio in background, and
	     receive non-call alerts. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
		<string>remote-notification</string>
	</array>

	<!-- Permission prompts (App Store rejects missing usage strings). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Wireline needs the microphone so you can speak on calls your agents place or hand to you.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Wireline adds reminders to your calendar when an agent schedules a follow-up.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Wireline adds events to your calendar when an agent books an appointment or follow-up for you.</string>
	<key>NSSiriUsageDescription</key>
	<string>Wireline lets you ask Siri to place or hand off calls through your agents.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Wireline can open Apple Music to play songs your agent recommends during a call.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Wireline adds reminders to your list when an agent schedules a follow-up.</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<!-- CarPlay Communication scene. The phone UI stays on SwiftUI's
		     default scene; this only adds the CarPlay template surface, and it
		     activates once Apple grants the carplay-communication entitlement. -->
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>WirelineCarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- Deep-link scheme used by widgets / Control Center to open the app at a
	     specific surface (e.g. wireline://ask, wireline://call/&lt;id&gt;). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.wireline.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wireline</string>
			</array>
		</dict>
	</array>

	<!-- Allow checking whether the Shortcuts app is installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>shortcuts</string>
	</array>
</dict>
</plist>
