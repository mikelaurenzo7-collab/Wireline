<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core bundle identity. Keep these explicit: App Intents reads the
	     processed bundle plist during SSU training. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleDisplayName</key>
	<string>BotBound</string>
	<key>CFBundleName</key>
	<string>BotBound</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>

	<key>NSSupportsLiveActivities</key>
	<true/>

	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
		<string>remote-notification</string>
	</array>

	<key>NSMicrophoneUsageDescription</key>
	<string>BotBound needs the microphone so you can speak on calls your Bots place or hand to you.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>BotBound adds reminders to your calendar when a Bot schedules a follow-up.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>BotBound adds events to your calendar when a Bot books an appointment or follow-up for you.</string>
	<key>NSSiriUsageDescription</key>
	<string>BotBound lets you ask Siri to place or hand off calls through your Bots.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>BotBound can open Apple Music to play songs your Bot recommends during a call.</string>
	<key>NSRemindersUsageDescription</key>
	<string>BotBound adds reminders to your list when a Bot schedules a follow-up.</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>WirelineCarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- The legacy wireline:// scheme remains for installed-version deep-link compatibility. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.wireline.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wireline</string>
			</array>
		</dict>
	</array>

	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>shortcuts</string>
	</array>
</dict>
</plist>
