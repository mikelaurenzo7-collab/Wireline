# =============================================================================
# Wireline — environment configuration
# =============================================================================
#
# Copy this file to `.env` and fill in real values for the integrations you
# need locally. The dev server (`npm run dev`) stubs missing integrations so
# you can run the whole console without a live Stripe / Vapi / model-provider
# account — routes for un-configured features return a 503 with an actionable
# JSON body instead of crashing.
#
# Production secrets live in Vercel project settings:
#   https://vercel.com/revaluate/wireline/settings/environment-variables
#
# Source of truth for the canonical list is `DEPLOY.md` and `ARCHITECTURE.md`.
# Live credentials and production provider configuration belong in Vercel's
# Production target only. Preview/Development values must be dedicated sandboxes
# and explicitly reviewed in scripts/check-deployment-boundaries.mjs; otherwise
# leave them unset. Never widen a production value across targets. Document every
# new key and its target policy in DEPLOY.md.
#
# !!  NEVER commit a populated .env. The repo's .gitignore protects you.
# =============================================================================

# ---------- Core platform ----------------------------------------------------
APP_URL=http://localhost:3000
# Comma-separated allowlist for cross-origin browser requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 64-character hex string. Generate with: `openssl rand -hex 32`.
# Canonical name for session JWT signing. `SUPABASE_JWT_SECRET` is a legacy
# alias kept for one rotation cycle — see DEPLOY.md.
INTERNAL_JWT_SECRET=

# 32-byte base64 string used for at-rest envelope encryption of stored OAuth
# tokens and any other tenant-secret blob. Generate with:
#   `openssl rand -base64 32`
WIRELINE_DATA_KEY=

# Random secret used to sign Vercel-scheduled cron requests so /api/jobs/sweep
# rejects anything else. Also the fallback monitor credential for the
# /api/health/launch-readiness family when HEALTH_MONITOR_TOKEN is unset.
CRON_SECRET=

# Dedicated monitor credential for /api/health/launch-readiness, /ready, and
# /slos (src/routes/health-routes.ts). Falls back to CRON_SECRET when unset.
HEALTH_MONITOR_TOKEN=

# Mark internal launch accounts and telemetry as demo-only. Set to false when
# the first real customer account is admitted.
WIRELINE_LAUNCH_DEMO_MODE=true

# Optional launch controls:
# LAUNCH_HARD_GATE                   — "true" blocks spend/checkout routes when any launch-readiness
#                                      capability is not ready (src/middleware/launch-hard-gate.ts).
#                                      Opt-in; unset leaves soft-launch spend paths open.
# WIRELINE_ALLOW_INMEMORY_RATE_LIMIT — non-prod escape hatch when Upstash is unavailable; never set in production
# OAuth state-parameter HMAC secret (server only). Any random string.
OAUTH_STATE_SECRET=

# ---------- Database ---------------------------------------------------------
# Supabase transaction pooler (port 6543) — REQUIRED for serverless.
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:6543/postgres
# Pooler URL the runtime prefers (env-validator marks this required in
# production). Mirror POSTGRES_URL when POSTGRES_URL already points at the
# transaction pooler.
DATABASE_POOL_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# ---------- LLM providers ----------------------------------------------------
# Primary managed structured runtime (direct OpenAI Responses API, GPT-5.6 Terra
# default) and OpenAI Realtime for Studio / ChatGPT / guest live-voice demos.
# Required in production (src/lib/env-validator.ts).
OPENAI_API_KEY=
# Separate key for ChatGPT app realtime voice spend isolation. The runtime
# falls back to OPENAI_API_KEY when unset, but production should configure this.
OPENAI_API_KEY_CHATKIT=
# Optional overrides for the OpenAI Realtime voice path
# (src/lib/voice/openai-realtime-config.ts). Defaults shown.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIBER=gpt-4o-mini-transcribe
# First automatic structured continuity fallback; also Vapi voice fallback +
# grounded-search fallback tool.
GEMINI_API_KEY=
# Governed multi-model continuity route for the managed runtime (Vercel AI Gateway).
AI_GATEWAY_API_KEY=
# xAI credential. Setting it activates two real runtime paths:
#   1. The Grok 4.6 structured primary on https://api.x.ai/v1/responses.
#      OpenAI, Gemini, and the AI Gateway remain ordered continuity.
#   2. Vapi PSTN language model grok-4.3 + xAI voices (Eve/Ara/Rex/Sal/Leo).
#      Direct api.x.ai/v1/tts is still used only for browser previews and
#      creative renders. Grok 4.6 is not a Vapi live-call model id.
XAI_API_KEY=
# Optional scoped xAI credential for isolated experiments.
XAI_API_KEY_CHATKIT=
# Optional managed-chain overrides (src/lib/ai-models.ts, src/lib/reasoning-provider-policy.ts):
# WIRELINE_OPENAI_STRUCTURED_MODEL          — OpenAI continuity model id (default gpt-5.6-terra)
# WIRELINE_GEMINI_STRUCTURED_FALLBACK_MODEL — Gemini fallback model id (default gemini-3.6-flash)
# WIRELINE_XAI_STRUCTURED_MODEL             — xAI primary model id (default grok-4.6)
# WIRELINE_ENABLE_XAI_STRUCTURED_FALLBACK   — false to disable the xAI lane even with a key present
# WIRELINE_STRUCTURED_PRIMARY_PROVIDER      — operator override for the FIRST lane:
#                                             xai (default) | openai | gemini | gateway.
#                                             The remaining lanes stay as continuity behind it.
# WIRELINE_DEEP_EFFORT                      — reasoning-speed dial for Deep mode: low | medium | high (default medium)

# Optional ops telemetry: log when rolling 24h AI spend crosses 1% of this value.
# Does not block requests. Usage draws from prepaid Runtime Balance.
CLAUDE_MONTHLY_BUDGET_USD=0
# Optional — Perplexity-first live public research for Wireline CEO agents.
# When set, fresh-public-research uses Perplexity first and Gemini as fallback.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
LIVE_RESEARCH_TIMEOUT_MS=8000

# ---------- Voice runtime (Vapi) ---------------------------------------------
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=
# Browser Vapi credentials are retired. Browser voice entry uses server-minted,
# one-use tickets and must never reintroduce a VITE_VAPI_PUBLIC_KEY value.
# Optional Vapi credential id for the hardened webhook-auth mechanism
# (src/lib/vapi-server-config.ts).
VAPI_WEBHOOK_CREDENTIAL_ID=
# Optional overrides for the public demo lines' aggregate daily spend ceiling
# (src/lib/showcase-demo-ceiling.ts). Defaults: 60 calls/day across all demo
# lines, 4/day per caller number.
WIRELINE_SHOWCASE_DAILY_CALL_CEILING=
WIRELINE_SHOWCASE_CALLER_DAILY_CALL_CEILING=
# Optional override for the per-tenant simultaneous live-call ceiling
# (src/lib/inbound-concurrency.ts). Inbound overflow beyond it degrades to the
# bounded take-a-message assistant. Default: 10.
WIRELINE_INBOUND_CONCURRENT_CALL_CEILING=
# Conservative per-unit reserves for platform-funded research/enrichment COGS
# metered against the tenant AI-spend envelope (src/middleware/audit-middleware.ts).
# Tune to the account's actual vendor contracts. Defaults: $0.01/request, $0.05/enrichment.
WIRELINE_PERPLEXITY_REQUEST_RESERVE_USD=
WIRELINE_APOLLO_ENRICHMENT_RESERVE_USD=

# ---------- Managed studio speech (ElevenLabs, server-only) -------------------
# Production-only founder credential for curated streaming TTS and authorized
# private voice cloning. Vapi orchestrates phone calls and carries a curated
# Vapi fallback per voice.
ELEVENLABS_API_KEY=

# ---------- Telephony (Twilio) ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred scoped REST credential (src/lib/twilio-service-base.ts). When set,
# REST calls authenticate with this API key pair and TWILIO_AUTH_TOKEN is used
# only for webhook signature verification.
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Optional canonical base URL for Twilio webhook signature validation when the
# public URL differs from the request host (src/lib/twilio-webhook-auth.ts).
TWILIO_WEBHOOK_BASE_URL=
# "false" disables tenant number auto-provisioning (defaults on in production;
# src/lib/phone-provisioning.ts).
WIRELINE_AUTO_PROVISION_NUMBERS=
# E.164 number used as the platform "from" for SMS escalations.
PLATFORM_SMS_FROM=

# ---------- Compliance (Federal DNC scrub) -----------------------------------
# Required before scaling marketing/outbound dialing campaigns. Current launch
# status: unconfigured pending business registration and EIN. Leave the key unset
# so marketing/campaign dials remain fail-closed.
# FEDERAL_DNC_API_KEY must be the vendor loginId (DNCScrub), NEVER a Vercel
# token (vcp_…). See src/lib/federal-dnc-service.ts and AGENTS.md.
FEDERAL_DNC_API_URL=https://www.dncscrub.com/app/main/rpc/scrub
FEDERAL_DNC_API_KEY=
FEDERAL_DNC_PROVIDER=dncscrub
# Non-production escape hatch only — never set in production.
FEDERAL_DNC_ALLOW_UNCONFIGURED=

# ---------- Mobile push (Wireline iOS — APNs / PushKit VoIP) -----------------
# Token-based APNs auth for waking the native Wireline app on inbound calls and
# mid-call tool dispatch. All optional: if unset, src/lib/apns-push.ts is a
# safe no-op and the rest of the platform is unaffected. Create the auth key in
# the Apple Developer portal (Keys → APNs). NEVER commit the .p8 contents.
APNS_KEY_ID=
APNS_TEAM_ID=
# PEM contents of the AuthKey_XXXX.p8 file. In Vercel, paste with literal
# newlines escaped as \n — the lib un-escapes them at load.
APNS_AUTH_KEY=
# App bundle id, e.g. com.wireline.app. VoIP pushes go to <bundle>.voip.
APNS_BUNDLE_ID=
# "production" (default) or "sandbox" for development device builds.
APNS_ENV=production

# ---------- Mobile push (Wireline Android — Firebase Cloud Messaging) --------
# Service-account credentials for the FCM HTTP v1 API. All optional: if unset,
# src/lib/fcm-push.ts is a safe no-op. Create a service account in the Firebase
# console (Project settings → Service accounts → Generate new private key) with
# the "Firebase Cloud Messaging API" enabled. NEVER commit the JSON key.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# PEM private_key from the service-account JSON. In Vercel, paste with literal
# newlines escaped as \n — the lib un-escapes them at load.
FCM_PRIVATE_KEY=

# ---------- Escalation routing ----------------------------------------------
# Platform owner email — gates owner-only admin surfaces and receives escalation/canary alerts
OWNER_EMAIL=you@example.com
# Optional staffed destination for account spend and reliability thresholds.
OPS_ALERT_EMAIL=
# Optional comma-separated additional owner emails (same privileges as OWNER_EMAIL)
OWNER_EMAILS=
OWNER_PHONE=

# ---------- Billing (Stripe) ------------------------------------------------
# Canonical founder launch catalog in src/lib/plan-catalog.ts:
#   personal   -> Wireline Free Builder ($0 create/simulate only)
#   starter    -> Wireline Starter ($19/mo, 50 voice minutes, $1 Runtime Allowance)
#   team       -> Wireline Starter Plus ($39/mo, 100 voice minutes, $3 Runtime Allowance)
#   business   -> Wireline Pro ($79/mo, 190 voice minutes, $6 Runtime Allowance)
#   enterprise -> retired legacy resolver only; new larger fleets use sales-assisted Scale
# Add-on: $15/mo per additional live agent adds 50 guaranteed voice minutes and 1 number slot.
# Runtime Balance top-ups cover extra voice at $0.22/min. No automatic postpaid overages.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
# Production-only read-only portal verification switch. The historical name is
# retained for environment compatibility. Canonical production builds fail closed
# unless this is true and the Wireline-managed Customer Portal matches policy.
# Repair confirmed drift explicitly with `npm run stripe:portal:reconcile`, then
# redeploy so production independently verifies the resulting state.
# Preview and Development must leave it unset/false.
WIRELINE_RECONCILE_STRIPE_PORTAL=false
# Leave false until Stripe Tax settings are active AND at least one applicable
# tax registration is active. Registration is a legal/tax decision; verify it
# with a qualified adviser before enabling collection.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Monthly subscription prices (Stripe acct_1TkyXL8e6If87QKm; public launch offers — $19/$39/$79)
STRIPE_STARTER_9_PRICE_ID=price_1Tx5X78e6If87QKmltXpASRU
STRIPE_STARTER_PRICE_ID=price_1Tx5XK8e6If87QKmQG9Jg0j2
STRIPE_TEAM_PRICE_ID=price_1Tx5Xa8e6If87QKmf1bWe8ol
# Legacy entitlement/webhook resolution only; never surface as self-serve checkout.
STRIPE_BUSINESS_PRICE_ID=price_1Tx5Xm8e6If87QKm7mC84oe8
# Annual prices (two months free on every public self-serve tier)
STRIPE_STARTER_9_ANNUAL_PRICE_ID=price_1Tx5XD8e6If87QKmCuwmYCK5
STRIPE_STARTER_ANNUAL_PRICE_ID=price_1Tx5XU8e6If87QKmIwF251n6
STRIPE_TEAM_ANNUAL_PRICE_ID=price_1Tx5Xg8e6If87QKmYFwRlCwi
# Legacy entitlement/webhook resolution only; never surface as self-serve checkout.
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_1Tx5Xs8e6If87QKmGxEvongq
# Licensed recurring add-on; quantity-adjusted in the app.
STRIPE_EXTRA_AGENT_PRICE_ID=price_1Tv9K58e6If87QKm7rzn3MNS
# Extra voice draws from prepaid Runtime Balance at the canonical per-minute rate.
# No Stripe meter event is configured.

# Retired Live Video SKU. Checkout is closed; leftover Stripe subscriptions
# still resolve against this price id so webhooks do not brick billing.
STRIPE_LIVE_VIDEO_ADDON_PRICE_ID=price_1Tv9K58e6If87QKmYM6sqWkL
STRIPE_LIVE_VIDEO_MONTHLY_PRICE_ID=price_1Tv9K58e6If87QKmYM6sqWkL

# Live talking-head video (LiveAvatar / HeyGen) is retired. Identity badges
# remain the in-app visual. Tenant clips use xAI Imagine via work companions
# (`XAI_API_KEY`). Do not set LIVEAVATAR_* or HEYGEN_* for new work.
# WIRELINE_LIVE_VIDEO_DISABLED is unused; the add-on is retired in code.

# ---------- ChatGPT app / MCP transport -------------------------------------
# HTTP MCP server + OAuth 2 + Client Identifier Metadata Document. See
# docs/CHATGPT_APP.md and docs/CHATGPT_APP_DASHBOARD_CONFIG.md.
# 64-char hex secret used to hash issued MCP OAuth token payloads (server-side
# pepper — does not encrypt anything on its own). Generate: `openssl rand -hex 32`.
MCP_OAUTH_TOKEN_PEPPER=
# Comma-separated allowlist of ChatGPT client_ids (from the ChatGPT app registration).
MCP_OAUTH_ALLOWED_CLIENT_IDS=
# Comma-separated allowlist of redirect URIs the ChatGPT app is permitted to use.
MCP_OAUTH_ALLOWED_REDIRECT_URIS=
# Signing secret bridging Wireline session cookies into the MCP OAuth flow.
OAUTH_BRIDGE_SECRET=
# Optional OpenAI key scoped to account-bound ChatGPT private simulation.
# Declared above with OPENAI_API_KEY; production should set OPENAI_API_KEY_CHATKIT.

# ---------- Rate limits + caching (Upstash Redis) ---------------------------
# Without these, rate limits fall back to in-memory and provide NO protection
# across serverless instances. Required for production safety.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Transactional email (Resend) ------------------------------------
# Production-only live sending credential.
RESEND_API_KEY=
# Production-only Svix/Resend signing secret for POST /api/webhooks/resend.
# Obtain from the Resend production webhook configured for
# https://trywireline.com/api/webhooks/resend. Keep preview/development unset or
# use dedicated sandbox endpoints/secrets.
RESEND_WEBHOOK_SECRET=
# From address — must use a domain verified in Resend (full value or bare email).
# Example: Wireline <noreply@trywireline.com>
RESEND_FROM_EMAIL=
# Alternative: verified domain only; builds Wireline <noreply@YOUR_DOMAIN>
RESEND_FROM_DOMAIN=

# ---------- Email compliance (CAN-SPAM / one-click unsubscribe) -------------
# Physical postal address rendered in the footer of COMMERCIAL email
# (e.g. trial-ending reminders). CAN-SPAM requires a valid postal address in
# commercial mail. Set this before turning on marketing/upsell email. The
# footer omits the address line when unset.
#   Example: WIRELINE_POSTAL_ADDRESS="Wireline, Inc., 2261 Market St #4242, San Francisco, CA 94114"
WIRELINE_POSTAL_ADDRESS=
# Mailbox for the mailto: fallback in the List-Unsubscribe header.
WIRELINE_UNSUBSCRIBE_MAILTO=unsubscribe@trywireline.com

# ---------- OAuth: identity providers ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# AgentMail: do not set a shared AGENTMAIL_API_KEY here. Tenants paste their
# org key in Connections; it is stored encrypted on wireline_email_accounts.
# Do not set AGENTMAIL_WEBHOOK_SECRET either — inbound delivery is registered
# automatically on connect and the signing secret stays on that mailbox row.

# ---------- OAuth: CRM + integrations --------------------------------------
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
APOLLO_API_KEY=
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional fallback Storefront API token when a connected shop's own token
# is not stored on the connection record (src/lib/shopify-storefront-service.ts).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# X (Twitter) — OAuth 2.0 + PKCE for tenant-connected posting
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional OAuth 1.0a / app-only keys (not required for tenant OAuth flow)
X_API_KEY=
X_API_SECRET=
# X Ads API (OAuth 1.0a user context — separate from tenant OAuth 2.0 connect)
X_ADS_ACCOUNT_ID=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=

# Slack (management alerts + tenant OAuth connect)
SLACK_MANAGEMENT_WEBHOOK=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Meta (FB / IG messaging + WhatsApp)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# ---------- DocuSign (e-signature) --------------------------------------------
DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_JWT_TOKEN=
DOCUSIGN_ACCESS_TOKEN=

# ---------- Observability ---------------------------------------------------
# The @sentry/* SDK was removed pre-launch; error reporting is a native-fetch
# no-op unless SENTRY_DSN is set (src/lib/error-reporter.ts). The build-time
# source-map vars (SENTRY_AUTH_TOKEN/ORG/PROJECT) and the browser Sentry SDK
# vars (VITE_SENTRY_*) are intentionally gone — do not reintroduce them without
# also adding the SDK/build plugin back.
SENTRY_DSN=

# ---------- Supabase client (browser) ---------------------------------------
# Only used by the frontend Supabase JS client (currently no production code
# paths depend on these — kept reserved for storage uploads).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- OAuth (mailbox + integrations — NOT sign-in) -----------------------
# Used only by Playwright authenticated visual QA and marketing/asset capture
# scripts (scripts/visual-qa-capture.mjs, scripts/marketing-kit.mjs,
# scripts/build-official-assets.mjs, scripts/dogfood-credentials.mjs,
# tests/e2e/design-gold-screens.spec.ts). DOGFOOD_EMAIL/DOGFOOD_PASSWORD and
# WIRELINE_E2E_EMAIL/WIRELINE_E2E_PASSWORD are accepted aliases, checked in
# that order before E2E_USER_EMAIL/E2E_USER_PASSWORD.
DOGFOOD_EMAIL=
DOGFOOD_PASSWORD=
WIRELINE_E2E_EMAIL=
WIRELINE_E2E_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
