# =============================================================================
# Wireline — environment configuration
# =============================================================================
#
# Copy this file to `.env` and fill in real values for the integrations you
# need locally. The dev server (`npm run dev`) stubs missing integrations so
# you can run the whole console without a live Stripe / Vapi / Anthropic
# account — routes for un-configured features return a 503 with an actionable
# JSON body instead of crashing.
#
# Production secrets live in Vercel project settings:
#   https://vercel.com/revaluate/wireline/settings/environment-variables
#
# Source of truth for the canonical list is `DEPLOY.md` and `ARCHITECTURE.md`.
# When you add a new key here, also add it to the Vercel project (Production
# + Preview + Development) and document it in DEPLOY.md.
#
# !!  NEVER commit a populated .env. The repo's .gitignore protects you.
# =============================================================================

# ---------- Core platform ----------------------------------------------------
APP_URL=http://localhost:3000
# Comma-separated allowlist for cross-origin browser requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 64-character hex string. Generate with: `openssl rand -hex 32`.
# Canonical name for session JWT signing. `SUPABASE_JWT_SECRET` is a legacy
# alias kept for one rotation cycle — see DEPLOY.md.
INTERNAL_JWT_SECRET=

# 32-byte base64 string used for at-rest envelope encryption of stored OAuth
# tokens and any other tenant-secret blob. Generate with:
#   `openssl rand -base64 32`
WIRELINE_DATA_KEY=

# Random secret used to sign Vercel-scheduled cron requests so /api/jobs/sweep
# and /api/daily-brief/schedule reject anything else.
CRON_SECRET=

# Random secret used to authorise /api/admin/migrate-* endpoints.
MIGRATION_TOKEN=

# OAuth state-parameter HMAC secret (server only). Any random string.
OAUTH_STATE_SECRET=

# ---------- Database ---------------------------------------------------------
# Supabase transaction pooler (port 6543) — REQUIRED for serverless.
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:6543/postgres
# Pooler URL the runtime prefers (env-validator marks this required in
# production). Mirror POSTGRES_URL when POSTGRES_URL already points at the
# transaction pooler.
DATABASE_POOL_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# ---------- LLM providers ----------------------------------------------------
# Claude Sonnet 4.6 (voice) + Opus 4.7 (reasoning). See ARCHITECTURE.md §1.
ANTHROPIC_API_KEY=
# Optional model overrides (Claude Console custom/agent model ids).
# ANTHROPIC_MODEL           — global reasoning default (briefs, coaching, post-call)
# ANTHROPIC_DIRECTOR_MODEL  — Director chat deep tier only (falls back to ANTHROPIC_MODEL)
# ANTHROPIC_PAINTER_MODEL   — Painter/Design Studio creative+reviewer (falls back to Director)
# ANTHROPIC_DEEP_EFFORT     — reasoning-speed dial for Deep mode: low | medium | high (default high)
ANTHROPIC_MODEL=
ANTHROPIC_DIRECTOR_MODEL=
ANTHROPIC_PAINTER_MODEL=
ANTHROPIC_DEEP_EFFORT=
# Optional ops telemetry: log when rolling 24h Claude spend crosses 1% of this value.
# Does not block requests — tenant overages bill through Stripe.
CLAUDE_MONTHLY_BUDGET_USD=0
# Voice fallback + grounded-search fallback tool.
GEMINI_API_KEY=
# Optional — Perplexity-first live public research for Wireline CEO agents.
# When set, fresh-public-research uses Perplexity first and Gemini as fallback.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
LIVE_RESEARCH_TIMEOUT_MS=8000
# Optional — used only by recipes that want OpenAI as a fallback.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_OPTIMIZER_MODEL=gpt-4o
# Optional — enables xAI / Grok as a per-agent voice model (Vapi-native).
# Without it, Grok is still reachable via OPENROUTER_API_KEY (with a latency
# trade-off — see VOICE_MODEL_CATALOG in src/lib/claude-models.ts).
XAI_API_KEY=
# Optional — Director chat model picker (company key; voice runtime unchanged).
# Gated to Pro+ plans in app; no extra env flags required.
OPENROUTER_API_KEY=
# Director creative tooling rollout flags
DIRECTOR_TOOL_EXECUTION_ENABLED=true
DIRECTOR_CREATIVE_TOOLS_ENABLED=true
DIRECTOR_ARTIFACTS_PANEL_ENABLED=true
# Wireline Design Studio (Spectrum Desk) — OpenRouter + Anthropic; not Google Stitch.
# Defaults on when OPENROUTER_API_KEY is set.
DIRECTOR_DESIGN_STUDIO_ENABLED=true
# Legacy alias (still read if DIRECTOR_DESIGN_STUDIO_ENABLED is unset):
# DIRECTOR_STITCH_MEDIA_ENABLED=true

# ---------- Wireline Design export integrations ----------------------------
# Figma OAuth (private app at figma.com/developers/apps — publish private for beta)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# Canva Connect (canva.com/developers — PKCE OAuth)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# GitHub OAuth for design → PR handoff (repo scope)
GITHUB_DESIGN_CLIENT_ID=
GITHUB_DESIGN_CLIENT_SECRET=

# ---------- Voice runtime (Vapi + ElevenLabs) --------------------------------
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=
VITE_VAPI_PUBLIC_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# ---------- Telephony (Twilio) ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# E.164 number used as the platform "from" for SMS escalations.
PLATFORM_SMS_FROM=

# ---------- Mobile push (Wireline iOS — APNs / PushKit VoIP) -----------------
# Token-based APNs auth for waking the native Wireline app on inbound calls and
# mid-call tool dispatch. All optional: if unset, src/lib/apns-push.ts is a
# safe no-op and the rest of the platform is unaffected. Create the auth key in
# the Apple Developer portal (Keys → APNs). NEVER commit the .p8 contents.
APNS_KEY_ID=
APNS_TEAM_ID=
# PEM contents of the AuthKey_XXXX.p8 file. In Vercel, paste with literal
# newlines escaped as \n — the lib un-escapes them at load.
APNS_AUTH_KEY=
# App bundle id, e.g. com.wireline.app. VoIP pushes go to <bundle>.voip.
APNS_BUNDLE_ID=
# "production" (default) or "sandbox" for development device builds.
APNS_ENV=production

# ---------- Mobile push (Wireline Android — Firebase Cloud Messaging) --------
# Service-account credentials for the FCM HTTP v1 API. All optional: if unset,
# src/lib/fcm-push.ts is a safe no-op. Create a service account in the Firebase
# console (Project settings → Service accounts → Generate new private key) with
# the "Firebase Cloud Messaging API" enabled. NEVER commit the JSON key.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# PEM private_key from the service-account JSON. In Vercel, paste with literal
# newlines escaped as \n — the lib un-escapes them at load.
FCM_PRIVATE_KEY=

# ---------- Escalation routing ----------------------------------------------
# Platform owner email — gates owner-only admin surfaces and receives escalation/canary alerts
OWNER_EMAIL=you@example.com
# Optional comma-separated additional owner emails (same privileges as OWNER_EMAIL)
OWNER_EMAILS=
OWNER_PHONE=

# ---------- Billing (Stripe) ------------------------------------------------
# Plan IDs and public names — see src/lib/plan-catalog.ts (canonical):
#   personal   → Wireline Personal ($0 create; Conversation Balance for live work)
#   team       → Wireline Team ($29/mo) — STRIPE_BUSINESS_STARTER_* env keys
#   business   → Wireline Business ($59/mo) — STRIPE_PRO_* env keys
#   enterprise → contact sales
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
# Monthly subscription prices
STRIPE_PERSONAL_PRICE_ID=
STRIPE_PERSONAL_PLUS_PRICE_ID=
STRIPE_BUSINESS_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Enterprise is contact-sales — leave empty unless you sell a custom contract price.
STRIPE_ENTERPRISE_PRICE_ID=
# Annual prices (~20% discount vs monthly × 12)
STRIPE_PERSONAL_ANNUAL_PRICE_ID=
STRIPE_PERSONAL_PLUS_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=
# Per-agent add-on line items (licensed recurring, quantity-adjusted in app)
STRIPE_PERSONAL_EXTRA_AGENT_PRICE_ID=
STRIPE_PERSONAL_PLUS_EXTRA_AGENT_PRICE_ID=
STRIPE_BUSINESS_STARTER_EXTRA_AGENT_PRICE_ID=
STRIPE_PRO_EXTRA_AGENT_PRICE_ID=
STRIPE_BUSINESS_EXTRA_AGENT_PRICE_ID=
# Voice-minute overage — metered prices (monthly interval, one per tier)
STRIPE_PERSONAL_OVERAGE_PRICE_ID=
STRIPE_PERSONAL_PLUS_OVERAGE_PRICE_ID=
STRIPE_BUSINESS_STARTER_OVERAGE_PRICE_ID=
STRIPE_PRO_OVERAGE_PRICE_ID=
STRIPE_BUSINESS_OVERAGE_PRICE_ID=
# Voice-minute overage meter event name (Stripe Dashboard → Billing → Meters)
STRIPE_VOICE_OVERAGE_METER_EVENT_NAME=

# Photoreal live-video add-on ($19/mo). The MONTHLY alias is honored as a
# fallback so ops can standardize on the SKU-shaped name. Set the same price
# id on both, or omit one — either works.
STRIPE_LIVE_VIDEO_ADDON_PRICE_ID=
STRIPE_LIVE_VIDEO_MONTHLY_PRICE_ID=

# ---------- LiveAvatar (HeyGen) — photoreal video presenter -----------------
# Optional. Without LIVEAVATAR_API_KEY (or HEYGEN_API_KEY as legacy alias),
# the live-video add-on is inert and /billing/live-video-checkout returns 503.
LIVEAVATAR_API_KEY=
HEYGEN_API_KEY=
# Ops-only bootstrap avatar UUID for included catalog face picks.
LIVEAVATAR_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_AVATAR_ID=
# "true" forces sandbox mode; unset ⇒ sandbox in non-production only.
LIVEAVATAR_SANDBOX=
# "true" lets platform owners bypass billing gates for enterprise pilots.
LIVE_VIDEO_BYPASS_BILLING=

# ---------- ChatGPT app / MCP transport -------------------------------------
# HTTP MCP server + OAuth 2 + Client Identifier Metadata Document. See
# docs/CHATGPT_APP.md and docs/CHATGPT_APP_DASHBOARD_CONFIG.md.
# 64-char hex secret used to hash issued MCP OAuth token payloads (server-side
# pepper — does not encrypt anything on its own). Generate: `openssl rand -hex 32`.
MCP_OAUTH_TOKEN_PEPPER=
# Comma-separated allowlist of ChatGPT client_ids (from the ChatGPT app registration).
MCP_OAUTH_ALLOWED_CLIENT_IDS=
# Comma-separated allowlist of redirect URIs the ChatGPT app is permitted to use.
MCP_OAUTH_ALLOWED_REDIRECT_URIS=
# Legacy no-auth demo transport signing secret. Only required while the
# unauthenticated /mcp compatibility handler remains mounted for guest demos.
