# GEMINI_API_KEY: Required for Gemini AI API calls.
# Server-side only. Never expose this to the client bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VAPI Variables
VAPI_PRIVATE_KEY=""
VITE_VAPI_PUBLIC_KEY=""

# Supabase Variables
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# (Optional) Service Role for backend overrides
SUPABASE_SERVICE_ROLE_KEY=""

# Google Workspace / Email OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL=""
WIRELINE_WEBHOOK_SECRET=""
OAUTH_STATE_SECRET=""

# Comma-separated list of origins allowed to call /api from the browser
# (CORS allowlist). Leave empty to allow same-origin only — the safe default
# when the SPA is served from the same host as the API.
# Example: ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"
ALLOWED_ORIGINS=""

# Replay-protection window for the Vapi webhook HMAC signature, in seconds.
# Requests whose X-Vapi-Timestamp falls outside ±this many seconds of the
# server clock are rejected. Defaults to 300 (5 minutes).
WEBHOOK_TIMESTAMP_TOLERANCE_SEC="300"
