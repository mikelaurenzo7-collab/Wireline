# =============================================================================
# Wireline — environment configuration
# =============================================================================
#
# Copy this file to `.env` and fill in real values for the integrations you
# need locally. The dev server (`npm run dev`) stubs missing integrations so
# you can run the whole console without a live Stripe / Vapi / Anthropic
# account — routes for un-configured features return a 503 with an actionable
# JSON body instead of crashing.
#
# Production secrets live in Vercel project settings:
#   https://vercel.com/revaluate/wireline/settings/environment-variables
#
# Source of truth for the canonical list is `DEPLOY.md` and `ARCHITECTURE.md`.
# When you add a new key here, also add it to the Vercel project (Production
# + Preview + Development) and document it in DEPLOY.md.
#
# !!  NEVER commit a populated .env. The repo's .gitignore protects you.
# =============================================================================

# ---------- Core platform ----------------------------------------------------
APP_URL=http://localhost:3000
# Comma-separated allowlist for cross-origin browser requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 64-character hex string. Generate with: `openssl rand -hex 32`.
# Canonical name for session JWT signing. `SUPABASE_JWT_SECRET` is a legacy
# alias kept for one rotation cycle — see DEPLOY.md.
INTERNAL_JWT_SECRET=

# 32-byte base64 string used for at-rest envelope encryption of stored OAuth
# tokens and any other tenant-secret blob. Generate with:
#   `openssl rand -base64 32`
WIRELINE_DATA_KEY=

# Random secret used to sign Vercel-scheduled cron requests so /api/jobs/sweep
# and /api/daily-brief/schedule reject anything else.
CRON_SECRET=

# Random secret used to authorise /api/admin/migrate-* endpoints.
MIGRATION_TOKEN=

# OAuth state-parameter HMAC secret (server only). Any random string.
OAUTH_STATE_SECRET=

# ---------- Database ---------------------------------------------------------
# Supabase transaction pooler (port 6543) — REQUIRED for serverless.
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# ---------- LLM providers ----------------------------------------------------
# Claude Sonnet 4.6 (voice) + Opus 4.7 (reasoning). See ARCHITECTURE.md §1.
ANTHROPIC_API_KEY=
# Voice fallback + grounded-search tool.
GEMINI_API_KEY=
# Optional — used only by recipes that want OpenAI as a fallback.
OPENAI_API_KEY=
# Optional — Director chat model picker (company key; voice runtime unchanged).
OPENROUTER_API_KEY=
# Director creative tooling rollout flags
DIRECTOR_TOOL_EXECUTION_ENABLED=true
DIRECTOR_CREATIVE_TOOLS_ENABLED=true
DIRECTOR_ARTIFACTS_PANEL_ENABLED=true

# ---------- Voice runtime (Vapi + ElevenLabs) --------------------------------
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=
VITE_VAPI_PUBLIC_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# ---------- Telephony (Twilio) ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# E.164 number used as the platform "from" for SMS escalations.
PLATFORM_SMS_FROM=

# ---------- Escalation routing ----------------------------------------------
# Platform owner email — gates owner-only admin surfaces and receives escalation/canary alerts
OWNER_EMAIL=mikelaurenzo7@gmail.com
# Optional comma-separated additional owner emails (same privileges as OWNER_EMAIL)
OWNER_EMAILS=
OWNER_PHONE=

# ---------- Billing (Stripe) ------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
# Monthly subscription prices (see src/lib/plan-catalog.ts)
STRIPE_PERSONAL_PRICE_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Enterprise is contact-sales — leave empty unless you sell a custom contract price.
STRIPE_ENTERPRISE_PRICE_ID=
# Annual prices (20% discount vs monthly × 12)
STRIPE_PERSONAL_ANNUAL_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=
# Per-agent add-on line items (licensed recurring, quantity-adjusted in app)
STRIPE_PERSONAL_EXTRA_AGENT_PRICE_ID=
STRIPE_STARTER_EXTRA_AGENT_PRICE_ID=
STRIPE_PRO_EXTRA_AGENT_PRICE_ID=
STRIPE_BUSINESS_EXTRA_AGENT_PRICE_ID=
# Voice-minute overage — metered prices (monthly interval, one per tier)
STRIPE_PERSONAL_OVERAGE_PRICE_ID=
STRIPE_STARTER_OVERAGE_PRICE_ID=
STRIPE_PRO_OVERAGE_PRICE_ID=
STRIPE_BUSINESS_OVERAGE_PRICE_ID=
# Voice-minute overage meter event name (Stripe Dashboard → Billing → Meters)
STRIPE_VOICE_OVERAGE_METER_EVENT_NAME=

# ---------- Rate limits + caching (Upstash Redis) ---------------------------
# Without these, rate limits fall back to in-memory and provide NO protection
# across serverless instances. Required for production safety.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Transactional email (Resend) ------------------------------------
RESEND_API_KEY=
# Optional override for the From address (defaults to Wireline <noreply@trywireline.com>)
RESEND_FROM_EMAIL=

# ---------- Email compliance (CAN-SPAM / one-click unsubscribe) -------------
# Physical postal address rendered in the footer of COMMERCIAL email
# (e.g. trial-ending reminders). CAN-SPAM requires a valid postal address in
# commercial mail. Set this before turning on marketing/upsell email. The
# footer omits the address line when unset.
#   Example: WIRELINE_POSTAL_ADDRESS="Wireline, Inc., 2261 Market St #4242, San Francisco, CA 94114"
WIRELINE_POSTAL_ADDRESS=
# Mailbox for the mailto: fallback in the List-Unsubscribe header.
WIRELINE_UNSUBSCRIBE_MAILTO=unsubscribe@trywireline.com

# ---------- OAuth: identity providers ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
YAHOO_APP_ID=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# ---------- OAuth: CRM + integrations --------------------------------------
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
APOLLO_API_KEY=
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_PRODUCTION_ACCESS_TOKEN=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Slack (alerts + slash commands)
SLACK_APP_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REFRESH_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=

# Meta (FB / IG messaging + WhatsApp)
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_API_BASE=https://graph.facebook.com/v20.0
META_OAUTH_AUTH_URL=https://www.facebook.com/v20.0/dialog/oauth
META_OAUTH_TOKEN_URL=https://graph.facebook.com/v20.0/oauth/access_token
META_VERIFY_TOKEN=

# ---------- Maps -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------- Observability ---------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- Supabase client (browser) ---------------------------------------
# Only used by the frontend Supabase JS client (currently no production code
# paths depend on these — kept reserved for storage uploads).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- E2E credentials (optional, never use in production) -------------
# Used only by Playwright authenticated visual QA.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
