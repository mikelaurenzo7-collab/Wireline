# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Powers the Claude Brain features —
#   pre-call briefings, lead qualification (BANT), objection drills,
#   cold-email composition, persona cloning, smart email drafts,
#   thread summarization with action items, fast intent routing,
#   and the deep agent performance review.
# Get yours: https://console.anthropic.com/settings/keys
# Without it, the /api/claude/* endpoints return 503 with a friendly message
# and the Claude Console UI shows an "Add Anthropic Key" prompt.
ANTHROPIC_API_KEY=""

# VAPI Variables
VAPI_PRIVATE_KEY=""
VITE_VAPI_PUBLIC_KEY=""

# Shared secret echoed back on every Vapi server webhook. Must match
# the assistant's `serverUrlSecret` (default: "wireline-secret-key").
# When set, /api/vapi-webhook rejects unsigned requests; when unset,
# we log a warning and accept them (so local dev works out of the box).
VAPI_WEBHOOK_SECRET=""

# Supabase Variables
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# (Optional) Service Role for backend overrides
SUPABASE_SERVICE_ROLE_KEY=""

# Google Workspace / Email OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public URL of this deployment — used to build the Google OAuth callback URL.
# Must exactly match the redirect URI registered in Google Cloud Console.
# Example: https://wireline.yourdomain.com
APP_URL="http://localhost:3000"
