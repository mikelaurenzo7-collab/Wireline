# GEMINI_API_KEY: Required for Gemini AI API calls.
# Server-side only. Never expose this to the client bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VAPI Variables
VAPI_PRIVATE_KEY=""
VITE_VAPI_PUBLIC_KEY=""

# Supabase Variables
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# (Optional) Service Role for backend overrides
SUPABASE_SERVICE_ROLE_KEY=""

# Google Workspace / Email OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL=""
WIRELINE_WEBHOOK_SECRET=""
OAUTH_STATE_SECRET=""
