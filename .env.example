# ─────────────────────────────────────────────────────────────────────────────
# Wireline — environment variables
#
# Copy this file to .env for local development.
# On Vercel, add each key via Project → Settings → Environment Variables.
#
# Sections below mirror the canonical integration order surfaced in the app
# (AdminSettings → System → Platform Health) and in the registry at
# src/lib/integrations-registry.ts. Do NOT re-sort — order is intentional.
#
#   1. Core           — Supabase
#   2. AI             — Anthropic, Gemini
#   3. Voice          — Vapi
#   4. OAuth          — Google, Microsoft
#   5. Billing        — Stripe
#   6. Action Engine  — Apollo, DocuSign (optional)
#   7. Infrastructure — Upstash Redis, Sentry
#   8. Security       — OAuth state secret, Secret Vault, Cron secret
#   9. Operational    — App URL, CORS, spend caps, bootstrap creds
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# 1. CORE — Supabase (database + auth)
# Required. Without these the app cannot start.
#
# Canonical Supabase project (Dashboard → Project Settings → API; paste anon
# and service_role keys from there — never commit real keys):
#   https://ogenlhodmwvyacvnrsnj.supabase.co
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://ogenlhodmwvyacvnrsnj.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Service Role key — used server-side for privileged DB operations.
# Do NOT expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# INTERNAL_JWT_SECRET — HMAC secret for Wireline session JWTs (auth middleware).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Legacy alias also accepted: SUPABASE_JWT_SECRET
INTERNAL_JWT_SECRET=""

# POSTGRES_URL — Postgres URI for server-side Drizzle (same DB as Supabase).
# Dashboard → Project Settings → Database → Connection string → URI.
# Use the pooler (transaction mode, port 6543, host like *.pooler.supabase.com)
# for Vercel/serverless — not the direct db.*.supabase.co:5432 session string.
# Use your database password here — not the anon JWT or service_role JWT.
#
# Recommended query suffix (append with ? or & as appropriate):
#   sslmode=require
#   application_name=-pooler.wireline   (workaround if anything checks for "-pooler." in the URL)
# Example shape (password is illustrative only):
#   postgresql://postgres.<ref>:<db_password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&application_name=-pooler.wireline
POSTGRES_URL=""


# ─────────────────────────────────────────────────────────────────────────────
# 2. AI — Anthropic Claude (primary) + Google Gemini (fallback + voice)
# Both required by design. See AGENTS.md for the dual-provider architecture.
# ─────────────────────────────────────────────────────────────────────────────

# ANTHROPIC_API_KEY — Powers Claude Brain: pre-call briefings, BANT
# qualification, objection drills, email composition, persona cloning,
# agent reviews, insights, triage, the Daily Brief, and every recipe.
# Get yours: https://console.anthropic.com/settings/keys
# Without it, /api/claude/* returns 503 and the UI prompts for a key.
ANTHROPIC_API_KEY=""

# ANTHROPIC_MODEL — Override the default Claude model id. Leave unset to use
# the in-code default (currently `claude-opus-4-7`, defined in
# src/lib/claude-brain.ts as CLAUDE_MODEL_DEFAULT). Useful for staging,
# A/B tests, or rolling back to an older opus/sonnet revision without
# redeploying. Both undated aliases (e.g. `claude-opus-4-7`,
# `claude-sonnet-4-6`) and dated revisions (e.g. `claude-opus-4-1-20250805`)
# are valid; dated revisions pin you to a fixed weights snapshot.
ANTHROPIC_MODEL=""

# GEMINI_API_KEY — Legacy fallback for non-Claude paths and the Vapi voice
# model. Get yours: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""


# ─────────────────────────────────────────────────────────────────────────────
# 3. VOICE — Vapi (inbound + outbound)
# Required. VAPI_WEBHOOK_SECRET must be set in production — the webhook
# rejects all requests when unset to prevent anonymous webhook spam.
# ─────────────────────────────────────────────────────────────────────────────
# VAPI_PRIVATE_KEY — Same value as “Private Key” under Vapi Dashboard → API
# Keys. Wireline sends it as Bearer token for server REST calls (/call/phone,
# carrier number sync).
VAPI_PRIVATE_KEY=""
# VITE_VAPI_PUBLIC_KEY — “Public Key” / browser key exposed to Vite bundles.
VITE_VAPI_PUBLIC_KEY=""

# Shared secret for Vapi server webhooks (HMAC-SHA256).
# Must match assistant serverUrlSecret and Phone Number webhook header when set.
# Vapi header: X-VAPI-SECRET (middleware also accepts legacy x-vapi-signature).
VAPI_WEBHOOK_SECRET=""


# ─────────────────────────────────────────────────────────────────────────────
# 4. OAUTH — Gmail (Google) + Outlook (Microsoft) for email agent mailboxes
# Optional. Without them, the email agent has no mailboxes to connect to.
# ─────────────────────────────────────────────────────────────────────────────

# Google Workspace / Gmail OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft / Outlook OAuth (Microsoft Identity Platform v2.0)
# Register an app at https://portal.azure.com or https://entra.microsoft.com → App registrations.
# Platform: Web — add Redirect URIs only (no separate "JavaScript origins" like Google).
# Delegated Graph permissions mirroring Wireline scopes (see src/lib/oauth-helpers.ts MS_SCOPES):
#   offline_access, openid, profile, User.Read, Mail.Send, Mail.Read,
#   Calendars.ReadWrite, Files.Read.All — then Grant admin consent if your tenant requires it.
# Redirect URIs (must match APP_URL origin exactly):
#   https://YOUR_PRODUCTION_ORIGIN/api/oauth/microsoft/callback
#   http://localhost:PORT/api/oauth/microsoft/callback   (local dev)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""


# ─────────────────────────────────────────────────────────────────────────────
# 5. BILLING — Stripe
# Optional. Without these, /api/billing/* returns 503 and the
# StripeBillingCard renders a "not configured" notice. The legacy
# subscription_status simulator in /admin still works for local dev.
# ─────────────────────────────────────────────────────────────────────────────

# Server-side secret key. Use sk_test_… in dev, sk_live_… in production.
# Get yours: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""

# Webhook signing secret. Get it from the webhook endpoint you create in
# the Stripe dashboard (Developers → Webhooks → Add endpoint pointing
# at https://YOUR_APP_URL/api/stripe-webhook). Subscribe at minimum to:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""

# Per-plan recurring price IDs. Create the products + monthly prices in
# Stripe first, then paste the price_… ids here. Plan names, agent
# limits, and feature lists live in code (server.ts STRIPE_PLANS) — only
# the price varies per environment / per Stripe account.
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""


# ─────────────────────────────────────────────────────────────────────────────
# 6. ACTION ENGINE — optional integrations wired through src/lib/action-engine.
# These run as no-ops when their env vars are unset. They MUST stay wired so
# operators can opt in at any time without a code change.
# ─────────────────────────────────────────────────────────────────────────────

# APOLLO_API_KEY — Apollo.io lead intelligence / autonomous prospecting.
# Required for the `prospect_leads` action type in the Action Engine
# (src/lib/action-engine.ts). When unset, `searchLeads()` and `enrichLead()`
# in src/lib/apollo-service.ts return empty results and the autonomous
# prospecting recipe is a no-op.
# Get yours: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=""

# DOCUSIGN — e-signature integration.
# Required for the `send_contract` action type in the Action Engine. When
# DOCUSIGN_ACCOUNT_ID or the access token is unset, sendContract() logs a
# warning and the action falls back to creating an internal task for the
# operator to handle manually (see src/lib/action-engine.ts handleSendContract).
#
# Production setup (DocuSign Admin → Apps and Keys):
#   1. Create an Integration Key (Client ID).
#   2. Add an RSA keypair, grant impersonation consent.
#   3. Mint a JWT user token via the JWT Grant flow and set DOCUSIGN_JWT_TOKEN.
# Local / sandbox testing:
#   Set DOCUSIGN_ACCESS_TOKEN to a short-lived OAuth access token instead.

# Base API URI. Use the demo (sandbox) endpoint while developing; switch to
# https://www.docusign.net/restapi for production accounts.
DOCUSIGN_BASE_URI="https://demo.docusign.net/restapi"

# DocuSign account GUID (Admin → API and Keys → API Account ID). Required —
# every envelope create call is scoped to a single account.
DOCUSIGN_ACCOUNT_ID=""

# Preferred: long-lived JWT access token minted via JWT Grant. Required for
# unattended server-side sends (the Action Engine cannot do an interactive
# OAuth dance).
DOCUSIGN_JWT_TOKEN=""

# Fallback: short-lived OAuth access token. Used only when DOCUSIGN_JWT_TOKEN
# is unset. Acceptable for local dev and one-off testing; not recommended for
# production because access tokens expire in ~1 hour.
DOCUSIGN_ACCESS_TOKEN=""

# SALESFORCE CRM — bi-directional contact and opportunity sync.
# Required for CRM actions (log_call, sync_contact, create_opportunity) in the
# Action Engine. Operator connects via OAuth popup in Admin → Integrations.
# Setup: Connected App in Salesforce Setup → App Manager → New Connected App.
#   OAuth scopes needed: api, refresh_token, id.
#   Callback URL: https://YOUR_APP_URL/api/oauth/salesforce/callback
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
# Optional: override login URL for sandbox (https://test.salesforce.com)
SALESFORCE_LOGIN_URL=""

# HUBSPOT CRM — bi-directional contact and deal sync.
# Required for CRM actions (log_call, sync_contact, create_deal) in the
# Action Engine. Operator connects via OAuth popup in Admin → Integrations.
# Setup: HubSpot → Settings → Account Setup → Integrations → Private Apps.
#   Or create a public OAuth app for multi-tenant use.
#   Callback URL: https://YOUR_APP_URL/api/oauth/hubspot/callback
#   Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.deals.read, crm.objects.deals.write, crm.objects.companies.read.
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# TWILIO — SMS / WhatsApp follow-ups, phone intelligence lookups, and
# manager escalation alerts. Used by the live voice agent tool layer and
# the Action Engine's `send_text_message` action type. Per-tenant enablement
# and sender selection are stored in wireline_settings.
# Setup: https://console.twilio.com/ → Account Dashboard / API Keys.
# For this server-side integration, use the primary Account SID + Auth Token.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# SLACK — Team notifications when agents book meetings, close deals, escalate.
# Operator connects workspace via OAuth popup in Admin → Integrations → Slack.
# Setup: https://api.slack.com/apps → Create New App → OAuth & Permissions.
#   Bot Token Scopes: chat:write, channels:read, groups:read, team:read.
#   Redirect URL: https://YOUR_APP_URL/api/oauth/slack/callback
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# SLACK_MANAGEMENT_WEBHOOK — Optional incoming webhook URL for urgent
# manager escalation alerts (e.g. frustrated caller detected). This is a
# plain Incoming Webhook (different from the OAuth bot above). Create one
# at https://api.slack.com/apps → Your App → Incoming Webhooks → Add New.
# When unset, manager alert Slack pings are silently skipped.
SLACK_MANAGEMENT_WEBHOOK=""

# ZOOM — Auto-generates meeting links when agents book calendar events.
# Operator connects their Zoom account via Admin → Integrations → Zoom.
# Setup: https://marketplace.zoom.us/develop/create → OAuth App.
#   Scopes: meeting:write:meeting, user:read:user.
#   Redirect URL: https://YOUR_APP_URL/api/oauth/zoom/callback
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# META (Facebook Login) — Marketing Graph / operator identity for future Pages & Ads hooks.
# Operators connect from Integrations → Meta (same OAuth row family as Slack/Zoom).
# Setup: https://developers.facebook.com/apps → Create App → Add “Facebook Login” product.
#   Valid OAuth Redirect URI: https://YOUR_APP_URL/api/oauth/meta/callback
#   Add localhost for dev: http://localhost:3000/api/oauth/meta/callback
META_APP_ID=""
META_APP_SECRET=""


# ─────────────────────────────────────────────────────────────────────────────
# 7. INFRASTRUCTURE — Upstash Redis (rate limits) + Sentry (observability)
# Strongly recommended in production. The app runs without them but loses
# distributed rate limiting and error aggregation.
# ─────────────────────────────────────────────────────────────────────────────

# UPSTASH REDIS — recommended for production / serverless.
# Without these, rate limits fall back to per-process in-memory state,
# which gives near-zero protection on Vercel where each invocation is its
# own worker. Sign up at https://console.upstash.com → create a Redis DB
# → REST API tab.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Production safety: when NODE_ENV=production (or VERCEL=1) and Upstash is
# NOT configured, spend-sensitive endpoints (Claude APIs, outbound dial)
# return 503 RATE_LIMITER_UNAVAILABLE to prevent unbounded spend on
# serverless platforms where the per-process limiter resets on every
# invocation. Set this to "true" ONLY for single long-lived node
# deployments (Docker / VM) where the in-memory limiter is actually
# effective. Leaving it unset is the secure default.
WIRELINE_ALLOW_INMEMORY_RATE_LIMIT=""

# SENTRY — error monitoring + source maps.
# Both DSNs are independent: VITE_SENTRY_DSN scopes the frontend,
# SENTRY_DSN scopes the backend. Leave unset to disable; the app no-ops.
# Create a project at https://sentry.io/  → Settings → Client Keys (DSN).
SENTRY_DSN=""
VITE_SENTRY_DSN=""

# Trace sampling (0–1). Defaults to 0.1; lower in high-traffic prod to
# control event volume.
SENTRY_TRACES_SAMPLE_RATE="0.1"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Source-map upload (build-time, optional). When all three are set, the
# Vite build emits sourcemaps, uploads them to Sentry, then deletes them
# from dist/ so they're not served publicly. Without these, prod stack
# traces show minified bundle paths.
# Create a token at: Sentry → Settings → Auth Tokens (scope: project:releases).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Git commit SHA — injected automatically by Vercel at build time as
# VERCEL_GIT_COMMIT_SHA. The Vite config exposes it to the frontend bundle
# via this VITE_ alias for Sentry release tagging. No action needed; listed
# here so the variable shows up in local env audits.
VITE_VERCEL_GIT_COMMIT_SHA=""


# ─────────────────────────────────────────────────────────────────────────────
# 8. SECURITY — crypto material and shared secrets.
# ─────────────────────────────────────────────────────────────────────────────

# OAUTH_STATE_SECRET — Secret used to HMAC-sign OAuth state tokens (CSRF
# protection for Google and Microsoft OAuth flows). Falls back to
# STRIPE_WEBHOOK_SECRET when unset. Set this to a random 32+ byte hex
# string in production.
OAUTH_STATE_SECRET=""

# WIRELINE_DATA_KEY — Secret Vault. Encrypts webhook signing secrets at
# rest (AES-256-GCM). Required to create/update webhooks with a signing
# secret. When unset, POST/PATCH /api/webhooks with a secret returns 503
# VAULT_UNCONFIGURED.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored encrypted secret — operators
# must re-enter the plaintext secret in WebhooksManager after rotation.
WIRELINE_DATA_KEY=""

# CRON_SECRET — bearer token required by POST /api/jobs/sweep when invoked
# from a cron job (Vercel Cron, GH Actions schedule, etc.). Manual sweeps
# from the Admin UI are gated by the admin/owner role instead.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required to be at least 16 characters; shorter values are rejected.
CRON_SECRET=""


# ─────────────────────────────────────────────────────────────────────────────
# 9. OPERATIONAL — app URL, CORS, spend caps, bootstrap creds.
# ─────────────────────────────────────────────────────────────────────────────

# APP_URL — The canonical public URL of this deployment.
# Required for Google OAuth redirect URIs and any absolute link generation.
# Examples:
#   Local dev  → http://localhost:3000
#   Vercel     → https://your-project.vercel.app  (or your custom domain)
# On Vercel this is automatically available as VERCEL_URL (hostname only, no https://).
# Wireline auto-derives APP_URL from VERCEL_URL when APP_URL is not set, so
# preview deployments work without manual configuration. For production with a
# custom domain, set APP_URL explicitly to your canonical URL.
APP_URL=""

# CORS_ORIGINS — comma-separated list of origins allowed to call the API.
# Required in production (NODE_ENV=production or VERCEL=1). Example:
#   CORS_ORIGINS="https://wireline.app,https://admin.wireline.app"
# In development this can be left empty (all origins allowed).
CORS_ORIGINS=""

# CLAUDE_MONTHLY_BUDGET_USD — Monthly Claude budget in USD (default: 50).
# Used to derive the automatic per-day safety cap: if cumulative spend in
# any 24-hour window exceeds 1 % of this value (i.e. $0.50 by default), all
# /api/claude/* endpoints return HTTP 402 until the window rolls over. This
# is a lightweight server-process guard — for DB-backed per-user hard caps,
# configure the budget in the app at Insights → AI Spend.
CLAUDE_MONTHLY_BUDGET_USD="50"

# Bootstrap creds for the one-shot setup-account.ts / check-env.ts scripts.
# Never commit real values. Set them inline when invoking the script:
#   WIRELINE_BOOTSTRAP_EMAIL=you@example.com WIRELINE_BOOTSTRAP_PASSWORD='…' \
#     npx ts-node setup-account.ts
WIRELINE_BOOTSTRAP_EMAIL=""
WIRELINE_BOOTSTRAP_PASSWORD=""
