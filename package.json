{
  "name": "wireline",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run assets && vite build && esbuild server.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/server.cjs --footer:js=\"module.exports.app = app;\"",
    "build:server": "esbuild server.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/server.cjs --footer:js=\"module.exports.app = app;\"",
    "vercel-build": "npm run build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "lint:strict": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.strict.json",
    "lint:eslint": "eslint --max-warnings 0 src/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "verify": "npm run lint && npm run build && npm run smoke:server",
    "assets": "node scripts/render-image-assets.mjs",
    "check-prod-env": "node scripts/check-prod-env.mjs",
    "stripe:setup": "node scripts/setup-stripe-billing.mjs",
    "stripe:sync-vercel": "node scripts/sync-stripe-env-to-vercel.mjs",
    "stripe:sync-secrets": "node scripts/sync-stripe-secrets-to-vercel.mjs",
    "vapi:sync-vercel": "node scripts/sync-vapi-env-to-vercel.mjs",
    "resend:sync-vercel": "node scripts/sync-resend-env-to-vercel.mjs",
    "vapi:patch-webhooks": "node scripts/patch-vapi-prod-webhooks.mjs",
    "vapi:patch-flux-ab": "node scripts/patch-vapi-showcase-flux-ab.mjs",
    "vapi:sync-showcase": "tsx scripts/sync-wireline-showcase.mts",
    "docs:check": "node scripts/check-readme-pricing.mjs",
    "csp:check": "node scripts/check-csp-drift.mjs && node scripts/csp-inventory.mjs",
    "csp:sync": "node scripts/check-csp-drift.mjs --write",
    "csp:inventory:update": "node scripts/csp-inventory.mjs --update",
    "authz:check": "tsx scripts/generate-authz-matrix.ts",
    "api-error:check": "node scripts/check-api-error-shape.mjs",
    "security:audit": "npm audit --audit-level=high --omit=dev",
    "security:audit:dev": "npm audit",
    "security:audit:full": "npm audit --omit=dev",
    "smoke:server": "VERCEL=1 node -e \"require('./dist/server.cjs'); console.log('server bundle imports')\"",
    "oauth:redirects": "node scripts/print-oauth-redirects.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:health": "tsx scripts/db-health-check.ts",
    "marketing:kit": "node scripts/marketing-kit.mjs",
    "prepare": "husky",
    "dogfood:reset": "node scripts/dogfood-reset.mjs",
    "dogfood:prod": "node scripts/prod-dogfood.mjs",
    "dogfood:marketing": "node scripts/dogfood-marketing.mjs",
    "dogfood:director": "node scripts/dogfood-director.mjs",
    "analyze": "VISUALIZE=1 vite build",
    "tenant-insert:check": "node scripts/check-user-id-inserts.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored --fix"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@clerk/backend": "^3.8.1",
    "@clerk/react": "^6.10.3",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@upstash/redis": "^1.38.0",
    "@vapi-ai/web": "^2.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "google-auth-library": "^10.7.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.40.0",
    "nodemailer": "^9.0.1",
    "openai": "^4.104.0",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "stripe": "^17.7.0",
    "svix": "^1.96.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^6.0.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.42.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
