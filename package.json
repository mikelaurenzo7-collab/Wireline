{
  "name": "wireline",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run assets && vite build && esbuild server.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/server.cjs --footer:js=\"module.exports.app = app;\"",
    "build:server": "esbuild server.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist/server.cjs --footer:js=\"module.exports.app = app;\"",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "lint:server": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.server.json",
    "lint:strict": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.strict.json",
    "lint:audit-modules": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.audit-modules.json",
    "lint:eslint": "eslint --max-warnings 0 .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "verify": "npm run design:check && npm run source-control:check && npm run route-registry:check && npm run docs:check && npm run openapi:check && npm run design:tokens:check && npm run stripe:catalog:check && npm run build && npm run smoke:server",
    "verify:full": "npm run lint && npm run lint:audit-modules && npm run lint:server && npm run lint:eslint && npm run design:check && npm run source-control:check && npm run route-registry:check && npm run docs:check && npm run openapi:check && npm run design:tokens:check && npm run stripe:catalog:check && npm run authz:check && npm run server:bootstrap:check && npm run tsconfig:excludes:check && npm run csp:check && npm run runtime:policy:check && npm run api-error:check && npm run security:audit && npm run test:run && npm run build && npm run smoke:server && node apps/browser-extension/scripts/build.mjs --check",
    "visual:qa": "node scripts/capture-visual-qa.mjs",
    "visual:qa:check": "node scripts/check-visual-qa-manifest.mjs",
    "visual:qa:full": "npm run build && node scripts/capture-visual-qa.mjs",
    "verify:contracts": "vitest run --pool vmThreads tests/product-voice-contract.test.ts tests/marketing-metadata-contract.test.ts tests/static-metadata-contract.test.ts tests/product-events-contract.test.ts tests/product-event-client-contract.test.ts tests/product-event-server-contract.test.ts tests/structured-runtime-policy-contract.test.ts tests/dual-voice-routing-contract.test.ts tests/chunk-recovery-contract.test.ts tests/guided-agent-learning-contract.test.ts tests/billing-proof-contract.test.ts tests/code-review-hardening-contract.test.ts tests/sales-trust-copy-contract.test.ts tests/sales-call-fixtures-contract.test.ts tests/sales-playbooks-contract.test.ts tests/sales-integration-policy-contract.test.ts",
    "test": "vitest --pool vmThreads --exclude 'tests/e2e/**'",
    "test:run": "vitest run --pool vmThreads --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --pool vmThreads --exclude 'tests/e2e/**' --coverage",
    "design:check": "node scripts/check-wireline-clear-system.mjs",
    "active-surface:check": "npm run design:check",
    "design:contract": "npm run design:check",
    "assets": "node scripts/render-image-assets.mjs",
    "check-prod-env": "node scripts/check-prod-env.mjs",
    "runtime:policy:check": "node scripts/check-openai-runtime-policy.mjs",
    "stripe:setup": "node scripts/setup-stripe-catalog.mjs",
    "stripe:audit-live": "node scripts/run-stripe-audit-from-vercel.mjs",
    "stripe:deactivate-retired-defaults": "node scripts/run-stripe-deactivate-retired-defaults.mjs",
    "stripe:catalog:check": "node scripts/check-stripe-catalog-contract.mjs",
    "stripe:sync-vercel": "node scripts/sync-stripe-env-to-vercel.mjs",
    "vapi:sync-vercel": "node scripts/sync-vapi-env-to-vercel.mjs",
    "resend:sync-vercel": "node scripts/sync-resend-env-to-vercel.mjs",
    "vapi:patch-webhooks": "node scripts/patch-vapi-prod-webhooks.mjs",
    "vapi:patch-flux-ab": "node scripts/patch-vapi-showcase-flux-ab.mjs",
    "vapi:sync-showcase": "tsx scripts/sync-wireline-showcase.mts",
    "csp:check": "node scripts/check-csp-drift.mjs",
    "csp:sync": "node scripts/check-csp-drift.mjs --write",
    "authz:check": "tsx scripts/generate-authz-matrix.ts",
    "api-error:check": "node scripts/check-api-error-shape.mjs",
    "security:audit": "npm audit --audit-level=high --omit=dev",
    "security:audit:dev": "npm audit",
    "security:audit:full": "npm audit --omit=dev",
    "smoke:server": "node -e \"process.env.VERCEL='1'; require('./dist/server.cjs'); console.log('server bundle imports')\"",
    "oauth:redirects": "node scripts/print-oauth-redirects.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:health": "tsx scripts/db-health-check.ts",
    "marketing:kit": "node scripts/marketing-kit.mjs",
    "prepare": "husky",
    "dogfood:reset": "node scripts/dogfood-reset.mjs",
    "dogfood:prod": "node scripts/prod-dogfood.mjs",
    "dogfood:marketing": "node scripts/dogfood-marketing.mjs",
    "analyze": "VISUALIZE=1 vite build",
    "tenant-insert:check": "node scripts/check-user-id-inserts.mjs",
    "server:bootstrap:check": "node scripts/check-server-bootstrap.mjs",
    "tsconfig:excludes:check": "node scripts/check-tsconfig-exclude-hygiene.mjs",
    "source-control:check": "node scripts/check-source-control-hygiene.mjs",
    "route-registry:check": "node scripts/check-route-registry.mjs",
    "docs:check": "node scripts/check-docs-index.mjs",
    "design:tokens:check": "node scripts/check-design-token-parity.mjs",
    "openapi:check": "node scripts/check-openapi-implementation.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored --fix"
    ]
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@heygen/liveavatar-web-sdk": "^0.0.18",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@upstash/redis": "^1.38.0",
    "@vapi-ai/web": "^2.5.2",
    "@vitejs/plugin-react": "^5.2.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "google-auth-library": "^10.7.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.4.2",
    "livekit-client": "^2.15.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.41.0",
    "nodemailer": "^9.0.1",
    "openai": "^4.104.0",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^6.0.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
