# Migration 0152/0153/0154/0155 snapshots. `scripts/materialize-drizzle-meta.mjs`
# recreates the exact SHA-pinned JSON from committed 0049 metadata before
# tests or Drizzle Kit.
/drizzle/migrations/meta/0050_snapshot.json
/drizzle/migrations/meta/0051_snapshot.json
/drizzle/migrations/meta/0052_snapshot.json
/drizzle/migrations/meta/0053_snapshot.json

# Generated launch-status snapshot (`npm run launch:status`). It records a
# point-in-time go/no-go probe of live production, so a committed copy is stale
# the moment it lands and reads as current truth.
docs/LAUNCH_STATUS.generated.json

# Git worktrees and session-local scripts
.worktrees/
worktrees/
scripts/.tmp-*
.superdesign/tmp/

# Generated marketing and official-asset exports
marketing-kit/
official-assets/
wireline-*-screenshots.zip
wireline-*-assets*.zip

# Full-resolution BotBound delivery media lives in the certified Drive tree.
# The repository keeps reproducible source code, compact editorial inputs, and
# proof captures; broadcast masters and editable presentation sources stay out
# of Git history.
/brand-work/gtm/*.pptx
/brand-work/selected/botbound-app-icon.png
/brand-work/commercial/*.png
/brand-work/launch-stills/*.png
/brand-work/exports/commercial/*.png
/brand-work/exports/ooh/*.png
/brand-work/exports/social/botbound-launch-instagram-1080-square.png
/brand-work/exports/social/botbound-launch-story-1080x1920.png
/brand-work/exports/product-proof/botbound-brand-ui-comparison.png

# Versioned launch releases keep reproducible source and human-authored copy in
# Git; rendered delivery masters, duplicate delivery fonts, and their generated
# manifests are trafficked through the private Google Drive release archive.
/brand-work/launch-2026-09/exports/
/brand-work/launch-2026-09/fonts/*.ttf
/brand-work/launch-2026-09/manifest.json
/brand-work/launch-2026-09/SHA256SUMS.txt
/brand-work/launch-2026-09-outbound/exports/
/brand-work/launch-2026-09-outbound/manifest.json
/brand-work/launch-2026-09-outbound/SHA256SUMS.txt
/brand-work/PROMOTIONAL-ASSET-INVENTORY-*.json
/brand-work/PROMOTIONAL-ASSET-INVENTORY-*.csv

# The root workspace is npm-managed. Stray pnpm bootstrap state is local noise.
/pnpm-lock.yaml
/pnpm-workspace.yaml

# Local sandbox-only Vitest override; not part of CI
vitest.sandbox.config.ts
