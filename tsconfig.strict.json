{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Item 8 — module-by-module TypeScript strictness hardening.
    //
    // Background: the base tsconfig.json sets `strict: false` (and
    // `allowJs: true`, `skipLibCheck: true`) because flipping strict
    // globally on a 500K-LOC server would surface thousands of errors
    // that have to be triaged. Instead we pilot strict mode on a
    // narrow allowlist of already-clean modules and grow the list as
    // each module is hardened.
    //
    // To run: `npm run lint:strict`. CI fails if any included file
    // breaks under strict mode, which means you cannot regress a
    // hardened module without explicitly relaxing it here.
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    // ─── Hardened modules — DO NOT remove without justification. ───
    // Each entry was inspected and confirmed to compile under strict.
    // Add a new entry only after verifying `npm run lint:strict` is clean.
    "src/types/pg-shim.d.ts",
    "src/types/audit.ts",
    "src/lib/secret-vault.ts",
    "src/middleware/require-role.ts",
    "src/lib/tenant-quotas.ts",
    "src/lib/soc2-controls.ts",
    "src/lib/customer-intel.ts",
    "src/lib/rate-limit.ts",
    // ─── Added 2026-Q1 audit (Sonnet/Opus tiering pass) ─────────────
    // The agent moat — pure helpers, no DB or I/O. Every branch is
    // covered by src/lib/agent-runtime.test.ts.
    "src/lib/agent-runtime.ts",
    "src/lib/personality-vibes.ts",
    // LLM tiering — constants and the function that decides which
    // model gets to handle a live call. Covered by claude-models.test.ts.
    "src/lib/claude-models.ts",
    // Pricing source of truth. Covered by plan-catalog.test.ts and
    // double-locked by scripts/check-readme-pricing.mjs.
    "src/lib/plan-catalog.ts",
    // Password + form validation — already had tests, now strict-clean.
    "src/lib/password-policy.ts",
    "src/lib/form-validators.ts",
    "src/lib/signup-intent.ts",
    // CSP builder — pure helper with snapshot test coverage.
    "src/lib/csp.ts",
    // ─── Added 2026-Q2 audit (production-readiness pass) ───────────
    // Account deletion helper — pure constant + small functions.
    "src/lib/account-deletion.ts",
    // TCPA consent helpers — pure validation logic.
    "src/lib/tcpa-consent.ts",
    // Postgres error code normalisation — pure helper.
    "src/lib/pg-errors.ts",
    // ─── Added 2026 audit follow-up (pure-helper test peers) ───────
    // Safe formatters — coerce unparsable API values to stable
    // fallbacks so a render never throws. Covered by safe-*.test.ts.
    "src/lib/safe-date.ts",
    "src/lib/safe-number.ts",
    // Agent scorecard math — pure outcome metrics extracted from
    // server.ts. Covered by agent-scorecard.test.ts.
    "src/lib/agent-scorecard.ts",
    // Wireline agent rule engines — escalation + objection handling.
    // Pure decision logic, covered by their *.test.ts peers.
    "src/lib/wireline-agent-escalation.ts",
    "src/lib/wireline-agent-objections.ts",
    // Test suites corresponding to the strict-clean modules
    "src/lib/agent-runtime.test.ts",
    "src/lib/personality-vibes.test.ts",
    "src/lib/claude-models.test.ts",
    "src/lib/plan-catalog.test.ts",
    "src/lib/password-policy.test.ts",
    "src/lib/form-validators.test.ts",
    "src/lib/signup-intent.test.ts",
    "src/lib/csp.test.ts",
    "src/lib/account-deletion.test.ts",
    "src/lib/tcpa-consent.test.ts",
    "src/lib/pg-errors.test.ts",
    "src/lib/safe-date.test.ts",
    "src/lib/safe-number.test.ts",
    "src/lib/agent-scorecard.test.ts",
    "src/lib/wireline-agent-escalation.test.ts",
    "src/lib/wireline-agent-objections.test.ts"
  ]
}
