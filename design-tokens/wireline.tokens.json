{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Wireline Mono design tokens. Minimal monochrome source for web, browser, and native outputs.",
  "color": {
    "canvas": { "default": { "$type": "color", "$value": "#F7F7F4" } },
    "surface": {
      "default": { "$type": "color", "$value": "#FFFFFF" },
      "subtle": { "$type": "color", "$value": "#F1F1EE" },
      "container": { "$type": "color", "$value": "#ECECEA" },
      "strong": { "$type": "color", "$value": "#D8D8D3" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#111111" },
      "secondary": { "$type": "color", "$value": "#6B6B66" },
      "onAction": { "$type": "color", "$value": "#FFFFFF" }
    },
    "action": {
      "primary": {
        "default": { "$type": "color", "$value": "#111111" },
        "pressed": { "$type": "color", "$value": "#000000" },
        "container": { "$type": "color", "$value": "rgba(17, 17, 17, 0.08)" }
      }
    },
    "border": {
      "default": { "$type": "color", "$value": "#E3E3E0" },
      "strong": { "$type": "color", "$value": "#C7C7C2" }
    },
    "focus": { "default": { "$type": "color", "$value": "#111111" } },
    "overlay": { "scrim": { "$type": "color", "$value": "rgba(17, 17, 17, 0.48)" } },
    "status": {
      "success": { "$type": "color", "$value": "#3F6F45" },
      "warning": { "$type": "color", "$value": "#86612D" },
      "error": { "$type": "color", "$value": "#A23A3A" },
      "info": { "$type": "color", "$value": "#4B5563" }
    },
    "feedback": {
      "success": { "surface": { "$type": "color", "$value": "#F1F7EF" }, "border": { "$type": "color", "$value": "#C9D8C3" } },
      "warning": { "surface": { "$type": "color", "$value": "#FAF5EA" }, "border": { "$type": "color", "$value": "#E3D4B8" } },
      "error": { "surface": { "$type": "color", "$value": "#FFF4F4" }, "border": { "$type": "color", "$value": "#E5C5C5" } },
      "info": { "surface": { "$type": "color", "$value": "#F3F4F6" }, "border": { "$type": "color", "$value": "#D1D5DB" } }
    }
  },
  "space": {
    "050": { "$type": "dimension", "$value": "4px" },
    "100": { "$type": "dimension", "$value": "8px" },
    "150": { "$type": "dimension", "$value": "12px" },
    "200": { "$type": "dimension", "$value": "16px" },
    "300": { "$type": "dimension", "$value": "24px" },
    "400": { "$type": "dimension", "$value": "32px" },
    "600": { "$type": "dimension", "$value": "48px" },
    "800": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "elevation": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(17, 17, 17, 0.05)" },
    "md": { "$type": "shadow", "$value": "0 14px 34px -26px rgba(17, 17, 17, 0.24)" },
    "lg": { "$type": "shadow", "$value": "0 28px 70px -44px rgba(17, 17, 17, 0.34)" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "standard": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "300ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "emphasized": { "$type": "cubicBezier", "$value": "cubic-bezier(0.16, 1, 0.3, 1)" }
    },
    "press": { "$type": "number", "$value": 0.985 }
  },
  "interaction": {
    "target": {
      "minimum": { "$type": "dimension", "$value": "24px" },
      "comfortable": { "$type": "dimension", "$value": "44px" }
    },
    "focus": {
      "width": { "$type": "dimension", "$value": "2px" },
      "offset": { "$type": "dimension", "$value": "2px" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Inter" },
      "body": { "$type": "fontFamily", "$value": "Inter" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" }
    }
  },
  "typography": {
    "display": { "size": { "$type": "dimension", "$value": "52px" }, "weight": { "$type": "number", "$value": 650 }, "lineHeight": { "$type": "dimension", "$value": "58px" }, "letterSpacing": { "$type": "dimension", "$value": "-0.04em" } },
    "h1": { "size": { "$type": "dimension", "$value": "36px" }, "weight": { "$type": "number", "$value": 650 }, "lineHeight": { "$type": "dimension", "$value": "42px" }, "letterSpacing": { "$type": "dimension", "$value": "-0.035em" } },
    "h2": { "size": { "$type": "dimension", "$value": "28px" }, "weight": { "$type": "number", "$value": 640 }, "lineHeight": { "$type": "dimension", "$value": "34px" }, "letterSpacing": { "$type": "dimension", "$value": "-0.03em" } },
    "h3": { "size": { "$type": "dimension", "$value": "21px" }, "weight": { "$type": "number", "$value": 630 }, "lineHeight": { "$type": "dimension", "$value": "28px" }, "letterSpacing": { "$type": "dimension", "$value": "-0.02em" } },
    "body": { "size": { "$type": "dimension", "$value": "15px" }, "weight": { "$type": "number", "$value": 400 }, "lineHeight": { "$type": "dimension", "$value": "24px" }, "letterSpacing": { "$type": "dimension", "$value": "0em" } },
    "bodyStrong": { "size": { "$type": "dimension", "$value": "15px" }, "weight": { "$type": "number", "$value": 600 }, "lineHeight": { "$type": "dimension", "$value": "24px" }, "letterSpacing": { "$type": "dimension", "$value": "0em" } },
    "caption": { "size": { "$type": "dimension", "$value": "13px" }, "weight": { "$type": "number", "$value": 400 }, "lineHeight": { "$type": "dimension", "$value": "18px" }, "letterSpacing": { "$type": "dimension", "$value": "0em" } },
    "overline": { "size": { "$type": "dimension", "$value": "11px" }, "weight": { "$type": "number", "$value": 650 }, "lineHeight": { "$type": "dimension", "$value": "16px" }, "letterSpacing": { "$type": "dimension", "$value": "0.08em" } }
  },
  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "dropdown": { "$type": "number", "$value": 1000 },
    "sticky": { "$type": "number", "$value": 1020 },
    "fixed": { "$type": "number", "$value": 1030 },
    "modalBackdrop": { "$type": "number", "$value": 1040 },
    "modal": { "$type": "number", "$value": 1050 },
    "popover": { "$type": "number", "$value": 1060 },
    "tooltip": { "$type": "number", "$value": 1070 }
  }
}
