{
  "manifest_version": 3,
  "name": "BotBound Command",
  "version": "0.1.3",
  "description": "Send the current page to your BotBound Workspace as reference for calls, texts, follow-ups, and tasks. Only when you click.",
  "homepage_url": "https://botbound.app",
  "action": {
    "default_title": "Open BotBound Command",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; font-src 'self'"
  },
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "commands": {
    "capture-current-page": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Send the current page to your BotBound Workspace"
    }
  }
}
