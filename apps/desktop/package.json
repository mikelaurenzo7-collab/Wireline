{
  "name": "botbound-desktop",
  "productName": "BotBound Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Owner-directed BotBound tasks on a shared application window and approved MCP tools.",
  "author": "BotBound",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "package:win": "node scripts/distribute.mjs package win32",
    "package:mac": "node scripts/distribute.mjs package darwin",
    "make:win": "node scripts/distribute.mjs make win32",
    "make:mac": "node scripts/distribute.mjs make darwin"
  },
  "config": {
    "forge": "./scripts/forge.config.cjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron-squirrel-startup": "1.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@types/node": "22.20.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "@electron/packager": {
      "extract-zip": "npm:@electron-internal/extract-zip@1.0.5"
    }
  }
}
