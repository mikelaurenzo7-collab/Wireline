{
  "name": "@botbound/second-ring-film",
  "version": "1.0.0",
  "private": true,
  "description": "BotBound launch film package — The Second Ring inbound and The First Move outbound",
  "scripts": {
    "audio:generate": "node scripts/generate-audio.mjs && ffmpeg -hide_banner -loglevel error -y -i public/audio/botbound-score.wav -codec:a libmp3lame -b:a 160k public/audio/botbound-score.mp3",
    "captions:export": "node scripts/export-captions.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion bundle src/index.ts --out-dir dist",
    "compositions": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion compositions src/index.ts",
    "studio": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion studio src/index.ts --no-open",
    "render:30": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-SecondRing-30s-4K out/botbound-second-ring-30s-4k.mp4 --codec=h264 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2",
    "render:15": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-SecondRing-15s-4K out/botbound-second-ring-15s-4k.mp4 --codec=h264 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2",
    "render:6": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-SecondRing-6s-4K out/botbound-second-ring-6s-4k.mp4 --codec=h264 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2",
    "render:vertical": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-SecondRing-15s-Vertical-4K out/botbound-second-ring-15s-vertical-4k.mp4 --codec=h264 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2",
    "render:6-vertical": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-SecondRing-6s-Vertical-4K out/botbound-second-ring-6s-vertical-4k.mp4 --codec=h264 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2",
    "render:square": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-SecondRing-10s-Square-4K out/botbound-second-ring-10s-square-4k.mp4 --codec=h264 --crf=15 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2",
    "render:launch-social": "node scripts/render-launch-social.mjs",
    "qa:launch-social": "node scripts/qa-launch-social.mjs",
    "render:outbound-social": "node scripts/render-outbound-social.mjs",
    "qa:outbound-social": "node scripts/qa-outbound-social.mjs",
    "render:logo-call:square": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-LogoCall-8s-Square ../../brand-work/logo-motion-2026-09/botbound-logo-call-8s-square-1080x1080.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k --concurrency=2 --overwrite",
    "render:logo-call:vertical": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-LogoCall-8s-Vertical ../../brand-work/logo-motion-2026-09/botbound-logo-call-8s-vertical-1080x1920.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k --concurrency=2 --overwrite",
    "render:logo-call": "npm run render:logo-call:square && npm run render:logo-call:vertical",
    "render:cinematic:inbound:horizontal": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-Cinematic-Inbound-12s-Horizontal ../../brand-work/cinematic-call-campaign-2026-09/botbound-cinematic-inbound-12s-horizontal-1920x1080.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2 --overwrite",
    "render:cinematic:inbound:vertical": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-Cinematic-Inbound-12s-Vertical ../../brand-work/cinematic-call-campaign-2026-09/botbound-cinematic-inbound-12s-vertical-1080x1920.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2 --overwrite",
    "render:cinematic:inbound:square": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-Cinematic-Inbound-12s-Square ../../brand-work/cinematic-call-campaign-2026-09/botbound-cinematic-inbound-12s-square-1080x1080.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2 --overwrite",
    "render:cinematic:outbound:horizontal": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-Cinematic-Outbound-12s-Horizontal ../../brand-work/cinematic-call-campaign-2026-09/botbound-cinematic-outbound-12s-horizontal-1920x1080.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2 --overwrite",
    "render:cinematic:outbound:vertical": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-Cinematic-Outbound-12s-Vertical ../../brand-work/cinematic-call-campaign-2026-09/botbound-cinematic-outbound-12s-vertical-1080x1920.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2 --overwrite",
    "render:cinematic:outbound:square": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-Cinematic-Outbound-12s-Square ../../brand-work/cinematic-call-campaign-2026-09/botbound-cinematic-outbound-12s-square-1080x1080.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2 --overwrite",
    "render:cinematic:double-feature": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion render src/index.ts BotBound-Cinematic-DoubleFeature-24s-Horizontal ../../brand-work/cinematic-call-campaign-2026-09/botbound-cinematic-double-feature-24s-horizontal-1920x1080.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=2 --overwrite",
    "render:cinematic": "npm run render:cinematic:inbound:horizontal && npm run render:cinematic:inbound:vertical && npm run render:cinematic:inbound:square && npm run render:cinematic:outbound:horizontal && npm run render:cinematic:outbound:vertical && npm run render:cinematic:outbound:square && npm run render:cinematic:double-feature",
    "test:media-qa": "node --test scripts/lib/media-qa.node-test.mjs",
    "render:all": "npm run render:30 && npm run render:15 && npm run render:6 && npm run render:vertical && npm run render:6-vertical && npm run render:square",
    "still:opening": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion still src/index.ts BotBound-SecondRing-30s-4K out/frame-opening.jpg --frame=28 --scale=0.5",
    "still:product": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion still src/index.ts BotBound-SecondRing-30s-4K out/frame-product.jpg --frame=342 --scale=0.5",
    "still:endcard": "NODE_OPTIONS=--require=./scripts/remotion-network-shim.cjs remotion still src/index.ts BotBound-SecondRing-30s-4K out/frame-endcard.jpg --frame=850 --scale=0.5"
  },
  "dependencies": {
    "@remotion/captions": "4.0.506",
    "@remotion/cli": "4.0.506",
    "@remotion/fonts": "4.0.506",
    "@remotion/media": "4.0.506",
    "@remotion/transitions": "4.0.506",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.506",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
